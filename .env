# ============================================
# FastAPI Service Configuration
# ============================================
FASTAPI_WORKERS=4
FASTAPI_THREADS=4
APP_ENV=production
PORT=8000

# ============================================
# MongoDB Configuration
# ============================================
MONGODB_URL=mongodb://mongo1:27017,mongo2:27017,mongo3:27017/?replicaSet=rs0
MONGODB_DB=utility_tunnel

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ============================================
# MQTT Configuration
# ============================================
MQTT_BROKER=mqtt
MQTT_PORT=1883
MQTT_TOPIC_CONTROL=tunnel/control
MQTT_TOPIC_STATUS=tunnel/status

# ============================================
# LoRa Simulator Configuration
# ============================================
LORA_API_URL=http://fastapi:8000/api/sensor/data
LORA_INTERVAL=60
LORA_NUM_ENV_SENSORS=200
LORA_NUM_MANHOLE_SENSORS=100

# Methane concentration ranges (volume %)
LORA_METHANE_NORMAL_MIN=0.0
LORA_METHANE_NORMAL_MAX=0.1
LORA_METHANE_ANOMALY_MIN=0.8
LORA_METHANE_ANOMALY_MAX=1.5

# Hydrogen sulfide concentration ranges (ppm)
LORA_H2S_NORMAL_MIN=0.0
LORA_H2S_NORMAL_MAX=5.0
LORA_H2S_ANOMALY_MIN=12.0
LORA_H2S_ANOMALY_MAX=20.0

# Oxygen concentration ranges (%)
LORA_OXYGEN_NORMAL_MIN=19.5
LORA_OXYGEN_NORMAL_MAX=20.5
LORA_OXYGEN_ANOMALY_MIN=16.0
LORA_OXYGEN_ANOMALY_MAX=17.5

# Temperature and humidity ranges
LORA_TEMPERATURE_NORMAL_MIN=18.0
LORA_TEMPERATURE_NORMAL_MAX=28.0
LORA_HUMIDITY_NORMAL_MIN=40.0
LORA_HUMIDITY_NORMAL_MAX=70.0

# Anomaly probability (0.01 = 1%)
LORA_ANOMALY_PROBABILITY=0.05

# ============================================
# PLC Simulator Configuration
# ============================================
PLC_MQTT_BROKER=mqtt
PLC_MQTT_PORT=1883
PLC_CONTROL_TOPIC=tunnel/control
PLC_STATUS_TOPIC=tunnel/status
PLC_TELEMETRY_TOPIC=tunnel/telemetry
PLC_RESPONSE_TOPIC_PREFIX=tunnel/response
PLC_API_URL=http://fastapi:8000
PLC_NUM_FANS=30
PLC_NUM_PUMPS=50
PLC_STATUS_INTERVAL=10
PLC_TELEMETRY_INTERVAL=60
PLC_ENABLE_MQTT=true
PLC_ENABLE_HTTP_FALLBACK=true

# ============================================
# System Control Parameters
# ============================================
OXYGEN_MIN=19.0
OXYGEN_MAX=21.0
TEMPERATURE_MAX=35.0
METHANE_ALARM=1.0
H2S_ALARM=10.0
OXYGEN_ALARM_LOW=18.0
PUMP_LEVEL_HIGH=80.0
PUMP_LEVEL_LOW=30.0
PUMP_DELAY=60

# ============================================
# PID Controller Parameters
# ============================================
PID_KP=2.0
PID_KI=0.5
PID_KD=0.1

# ============================================
# System Configuration
# ============================================
TUNNEL_LENGTH=15.0
FANS_PER_CHAMBER=10
CHAMBERS=["电力舱", "水信舱", "燃气舱", "综合"]

# ============================================
# New Feature Device Counts
# ============================================
NUM_FIBER_SENSORS=100
NUM_SMOKE_SENSORS=60
NUM_INSPECTION_ROBOTS=5
NUM_FIRE_DOORS=16
NUM_FIRE_EXTINGUISHERS=50

# ============================================
# Structure Monitoring Thresholds
# ============================================
STRUCTURE_STRAIN_WARNING=200
STRUCTURE_STRAIN_CRITICAL=400
STRUCTURE_CRACK_WARNING_MM=0.2
STRUCTURE_CRACK_CRITICAL_MM=0.5

# ============================================
# Fire Detection Parameters
# ============================================
FIRE_TEMP_RATE_WARNING=2
FIRE_TEMP_RATE_CRITICAL=5
FIRE_SMOKE_DENSITY_WARNING=5
FIRE_SMOKE_DENSITY_CRITICAL=15
FIRE_PROBABILITY_THRESHOLD=0.7

# ============================================
# Robot Inspection Parameters
# ============================================
ROBOT_HIGH_TEMP_THRESHOLD=40
ROBOT_HIGH_HUMIDITY_THRESHOLD=80
ROBOT_METHANE_THRESHOLD=0.5
ROBOT_H2S_THRESHOLD=5

# ============================================
# Asset Management Parameters
# ============================================
LIFE_PREDICTION_MODEL=default
LIFE_PREDICTION_INTERVAL=24
MAINTENANCE_PRIORITY_WEIGHT_LIFE=0.4
MAINTENANCE_PRIORITY_WEIGHT_INTERVAL=0.3
MAINTENANCE_PRIORITY_WEIGHT_FAILURE=0.3
