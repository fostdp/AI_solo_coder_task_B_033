APP_NAME=地下管廊综合监控系统
APP_VERSION=3.0.0

TZ=Asia/Shanghai

# ========== FastAPI 配置 ==========
GUNICORN_WORKERS=4
GUNICORN_WORKER_CLASS=uvicorn.workers.UvicornWorker
GUNICORN_TIMEOUT=120
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_PRELOAD=true
GUNICORN_LOGLEVEL=info

# ========== MongoDB 配置 ==========
MONGODB_URL=mongodb://mongos:27020,mongo1:27017,mongo2:27018,mongo3:27019/?replicaSet=rs0
MONGODB_DB=pipe_corridor

# ========== Redis 配置 ==========
REDIS_URL=redis://redis:6379/0

# ========== MQTT 配置 ==========
MQTT_BROKER=mqtt-broker
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ========== LoRa 网关模拟器配置 ==========
LORA_API_URL=http://backend:8000/api
LORA_SENSOR_COUNT=200
LORA_MANHOLE_COUNT=100
LORA_INTERVAL=60
LORA_BATCH_SIZE=50
LORA_USE_BATCH=true

# 气体浓度范围配置
LORA_OXYGEN_MIN=19.5
LORA_OXYGEN_MAX=21.0
LORA_OXYGEN_DROP_MIN=1.5
LORA_OXYGEN_DROP_MAX=3.0

LORA_METHANE_MIN=0.0
LORA_METHANE_MAX=0.1
LORA_METHANE_ALARM_MIN=0.8
LORA_METHANE_ALARM_MAX=2.5

LORA_H2S_MIN=0.0
LORA_H2S_MAX=5.0
LORA_H2S_ALARM_MIN=8.0
LORA_H2S_ALARM_MAX=25.0

LORA_TEMP_MIN=22.0
LORA_TEMP_MAX=28.0
LORA_HUMIDITY_MIN=45.0
LORA_HUMIDITY_MAX=65.0

# 异常概率配置
LORA_METHANE_PEAK_PROB=0.02
LORA_H2S_PEAK_PROB=0.02
LORA_OXYGEN_DROP_PROB=0.015
LORA_PEAK_DURATION_MIN=3
LORA_PEAK_DURATION_MAX=8
LORA_DROP_DURATION_MIN=5
LORA_DROP_DURATION_MAX=12
LORA_MANHOLE_OPEN_PROB=0.01
LORA_ILLEGAL_OPEN_PROB=0.3

# ========== PLC 模拟器配置 ==========
PLC_CLIENT_ID=plc-simulator
PLC_FAN_COUNT=30
PLC_PUMP_COUNT=50
PLC_TELEMETRY_INTERVAL=5
PLC_STATUS_INTERVAL=30

# 水泵参数
PLC_LEVEL_CHANGE_PROB=0.05
PLC_LEVEL_UP_MAX=0.005
PLC_LEVEL_DOWN_MAX=0.003
PLC_PUMP_RATE=0.002

# ========== 告警配置 ==========
OXYGEN_MIN=19.0
OXYGEN_MAX=21.0
TEMP_MAX=35.0
METHANE_ALARM=1.0
H2S_ALARM=10.0
OXYGEN_DANGER=18.0

# ========== 水泵控制参数 ==========
PUMP_START_LEVEL=0.8
PUMP_STOP_LEVEL=0.3
PUMP_DELAY=30

# ========== 短信配置 ==========
SMS_API_URL=http://sms-simulator:8001/sms

# ========== 模糊控制配置 ==========
FUZZY_CONFIG_PATH=config/fuzzy_logic.yaml
